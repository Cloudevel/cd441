# Plantilla de variables de entorno de la API. Copia a `.env` y ajusta.
# `.env` NUNCA se sube al repositorio (está en .gitignore y en .dockerignore).

# Puerto de escucha (Cloud Run lo inyecta; en local y en Compose: 8080).
PORT=8080

# SHA del commit desplegado; los workflows lo rellenan solos.
APP_VERSION=dev

# Clave de Flask. Si se omite, se genera una aleatoria en cada arranque.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Opcional. Si se define, las tareas se guardan en PostgreSQL; si no, en memoria.
# En el despliegue Linux la compone api/deploy/compose.yaml a partir de
# POSTGRES_PASSWORD; no la escribas a mano con una contraseña real aquí.
# DATABASE_URL=postgresql://cd441:<contraseña>@db:5432/cd441
