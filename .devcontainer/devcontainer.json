{
  "name": "cd441 · Cloudevel",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/dhoeric/features/google-cloud-cli:1": {}
  },
  "forwardPorts": [8080, 2222],
  "postCreateCommand": "python -m pip install --user --no-cache-dir ipykernel==7.4.0 bash_kernel==0.10.0 && python -m bash_kernel.install --user",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "remoteUser": "vscode"
}
