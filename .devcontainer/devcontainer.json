{
  "name": "cd441 · Cloudevel",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {},
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {}
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "API de ejemplo",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "remoteUser": "vscode"
}
